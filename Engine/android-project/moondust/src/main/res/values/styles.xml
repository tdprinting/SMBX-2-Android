<resources>

    <!-- Activity theme for the native Android UI (mod browser). Material is part of the SDK (API 21+). -->
    <style name="N64.Activity" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/n64_charcoal</item>
        <item name="android:colorPrimary">@color/n64_charcoal</item>
        <item name="android:colorPrimaryDark">@color/n64_charcoal_deep</item>
        <item name="android:colorAccent">@color/n64_yellow</item>
        <item name="android:statusBarColor">@color/n64_charcoal_deep</item>
        <item name="android:navigationBarColor">@color/n64_charcoal_deep</item>
    </style>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="N64.Activity">
    </style>

    <!-- Chunky dialog buttons: blue = confirm (A), red = cancel/destructive, dark = neutral -->
    <style name="N64.DialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/n64_btn_text</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="N64.DialogButton.Positive">
        <item name="android:background">@drawable/n64_btn_blue</item>
    </style>
    <style name="N64.DialogButton.Negative">
        <item name="android:background">@drawable/n64_btn_red</item>
    </style>
    <style name="N64.DialogButton.Neutral">
        <item name="android:background">@drawable/n64_btn_dark</item>
    </style>

    <!-- AlertDialog theme: gray panel, dark readable text -->
    <style name="N64Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/n64_dialog_bg</item>
        <item name="android:textColorPrimary">@color/n64_ink</item>
        <item name="android:textColorSecondary">@color/n64_ink</item>
        <item name="android:textColor">@color/n64_ink</item>
        <item name="android:colorAccent">@color/n64_yellow</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/N64.DialogButton.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/N64.DialogButton.Negative</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/N64.DialogButton.Neutral</item>
    </style>

</resources>
