<?xml version="1.0" encoding="utf-8"?>
<!-- Recessed address field. Focused: thick yellow ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="@color/n64_field_bg"/>
            <stroke android:width="4dp" android:color="@color/n64_yellow"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="@color/n64_field_bg"/>
            <stroke android:width="3dp" android:color="@color/n64_gray_dark"/>
        </shape>
    </item>
</selector>
