<?xml version="1.0" encoding="utf-8"?>
<!-- Controller-body gray panel with a dark lower edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/n64_charcoal_deep"/>
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="@color/n64_gray_light"
                android:centerColor="@color/n64_gray"
                android:endColor="@color/n64_gray_dark"/>
        </shape>
    </item>
</layer-list>
